# FastAPI service (also serves the HTML/JS page at "/")
# Build from the project root:  docker build -f deploy/Dockerfile.api -t thyrocheck-api .
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PORT=8080 TF_CPP_MIN_LOG_LEVEL=2
RUN apt-get update && apt-get install -y --no-install-recommends libgl1 libglib2.0-0 && rm -rf /var/lib/apt/lists/*
WORKDIR /app

COPY deploy/requirements-api.txt .
RUN pip install --no-cache-dir -r requirements-api.txt

COPY configs/ configs/
COPY src/ src/
COPY api/ api/
COPY web/ web/
# Bake the trained model into the image (or leave it out and set HF_MODEL_REPO at runtime)
COPY outputs/models/ outputs/models/

ENV PYTHONPATH=/app/src
EXPOSE 8080
CMD ["sh", "-c", "uvicorn api.main:app --host 0.0.0.0 --port ${PORT}"]
